{
  "name": "photolist",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "npm run setup && expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "apk": "npm run setup && cross-env EAS_SKIP_AUTO_FINGERPRINT=1 npx eas-cli@latest build --platform android --profile preview",
    "bundle:site": "node scripts/build-static-site-bundle.js",
    "setup": "npm run bundle:site"
  },
  "dependencies": {
    "expo": "~54.0.36",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-file-system": "~19.0.24",
    "expo-location": "~19.0.8",
    "expo-media-library": "~18.2.1",
    "react-native-webview": "13.15.0",
    "expo-application": "~7.0.8"
  },
  "private": true,
  "devDependencies": {
    "cross-env": "7.0.3"
  }
}
